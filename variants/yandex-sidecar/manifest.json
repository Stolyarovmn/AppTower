{
  "manifest_version": 3,
  "name": "App Tower",
  "short_name": "App Tower",
  "version": "1.0.0",
  "description": "App Tower with sidecar fallback for Chromium-family browsers without chrome.sidePanel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "favicon",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "declarativeNetRequestFeedback",
    "windows",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open App Tower"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/rail.js"
      ],
      "css": [
        "content/rail.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "content/embedded-frame.js"
      ],
      "run_at": "document_start",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": [
        "content/pwa-discovery.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http: https:"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "optional_permissions": [
    "contentSettings",
    "notifications"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open App Tower search"
    }
  }
}
