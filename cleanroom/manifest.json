{
  "manifest_version": 3,
  "name": "AppTower Cleanroom",
  "version": "2.3.0",
  "description": "From-scratch AppTower lifecycle and side-panel implementation.",
  "minimum_chrome_version": "141",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "favicon"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AppTower",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-space.js",
        "icon-data.js",
        "entity-icons.js",
        "rail.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open AppTower search"
    }
  },
  "optional_permissions": [
    "contentSettings"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
